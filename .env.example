# Qwen configuration is used by F03. F01 can start without these values.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen3.8-27B
# Controls provider-specific request fields and call-log labels:
# dashscope / llamacpp / vllm.
QWEN_PROVIDER=dashscope
# Qwen3.8-27B image pixel cap; valid range: 65536-16777216.
QWEN_MAX_PIXELS=8388608
# Optional reasoning effort: none / low / medium / xhigh.
# For compatible hybrid-reasoning models, none disables thinking.
# Leave unset to preserve the provider's default behavior.
# QWEN_REASONING_EFFORT=none

# One JSON object per analysis call. Relative paths are resolved from the
# process working directory; the default is <project-root>/model_calls.jsonl.
# CALL_LOG_PATH=model_calls.jsonl

# Optional Gradio server settings.
HOST=127.0.0.1
PORT=7860
