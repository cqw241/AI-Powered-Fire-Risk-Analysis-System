# Qwen configuration is used by F03. F01 can start without these values.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen3.8-27B
# Optional reasoning effort for compatible OpenAI-style providers: low / medium / xhigh.
# Leave unset to preserve the provider's default behavior.
# QWEN_REASONING_EFFORT=low

# Optional Gradio server settings.
HOST=127.0.0.1
PORT=7860
