# Qwen configuration is used by F03. F01 can start without these values.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen3.8-27B
# Reasoning effort for compatible OpenAI-style providers: low / medium / xhigh.
# Keep this configurable so DashScope and future self-hosted vLLM endpoints can share the same client path.
QWEN_REASONING_EFFORT=low

# Optional Gradio server settings.
HOST=127.0.0.1
PORT=7860
