{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_result.schema.json",
  "title": "AnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "no_findings",
        "image_unusable",
        "model_failed",
        "invalid_model_output"
      ]
    },
    "message": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analysis_finding"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "bboxes"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "bboxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bbox"
          }
        }
      }
    },
    "legal_association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "source_name",
        "clause_number",
        "clause_text",
        "relation",
        "missing_conditions"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "clause_number": {
          "type": "string",
          "minLength": 1
        },
        "clause_text": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "direct",
            "conditional"
          ]
        },
        "missing_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "analysis_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "description",
        "risk_priority",
        "risk_mechanism",
        "evidence",
        "legal_associations",
        "limitations",
        "recommended_action"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "risk_priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "risk_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "legal_associations": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/legal_association"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
